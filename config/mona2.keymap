#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// レイヤー番号（番号が大きいレイヤが勝つ。MOUSE は一番下にして、押して出すレイヤに負けるようにする）
#define BASE  0
#define MOUSE 1   // ボールを動かすと自動で入る（mona2_r.overlay の zip_temp_layer が layer 1 を指す）。J/K・左親指修飾キー以外を押すか、英語/日本語コンボで抜ける
#define SYM   2   // Tab長押し
#define NUM   3   // Spc長押し
#define NAV   4   // 左手真ん中の親指（レイヤ専用）。押している間ボールがスクロールになる（mona2_r.overlay の scroller が layer 4 を見ている）
#define SYS   5   // Tab+Spc 同時長押し
#define WIN   6   // Windows モード（SYS 層の E でトグル。電源再投入で OFF に戻る）。親指列の Ctrl と Win(Cmd) を入れ替え、IME は 英数/ひらがな キーで切替。
                  // 最上位層なので ON の間はコンボの判定層が常に WIN になる（layers = <WIN> のコンボが発火する）

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <150>;
    flavor = "balanced";
};

// オートマウスレイヤ：
// - 最後のキー入力から200ms以内のボール移動では入らない（文字入力中の誤発火防止）
// - excluded-positions に無いキーを押したら自動で抜ける（J/K=クリック と 左親指の Ctrl/Alt/Shift/Cmd は除外。修飾キー+クリックができるように）
//   ※ excluded-positions が空だとキー押下による解除自体が無効になるので、必ず1つ以上入れておくこと
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <17 18 33 34 35 36>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // コンボは「一番上のアクティブ層」で判定されるので、Mac 用は BASE/MOUSE、Windows 用は WIN を指定する

        // F + D 同時押しで英語（Mac: 英数 INT5）+ マウスレイヤ終了
        ime_en {
            bindings = <&ime_en_exit>;
            key-positions = <12 13>;
            layers = <BASE MOUSE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        // J + K 同時押しで日本語（Mac: かな INT4）+ マウスレイヤ終了
        ime_ja {
            bindings = <&ime_ja_exit>;
            key-positions = <17 18>;
            layers = <BASE MOUSE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        // F + D 同時押しで英語（Windows JIS: 英数キー → 半角英数モード）+ マウスレイヤ終了
        ime_en_win {
            bindings = <&ime_en_win>;
            key-positions = <12 13>;
            layers = <WIN>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        // J + K 同時押しで日本語（Windows JIS: カタカナひらがなキー → ひらがな入力で IME オン）+ マウスレイヤ終了
        ime_ja_win {
            bindings = <&ime_ja_win>;
            key-positions = <17 18>;
            layers = <WIN>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        // Tab + Spc 同時押し：タップでEsc、長押しで設定レイヤー
        combo_esc_sys {
            bindings = <&lt SYS ESC>;
            key-positions = <38 39>;
        };
    };

    macros {
        // マウスレイヤを抜けるのは &tog_off（OFF にするだけ）。&tog だと MOUSE が OFF のとき逆に ON になってしまう

        // 英語にしてマウスレイヤを抜ける（Mac）
        ime_en_exit: ime_en_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT5>, <&tog_off MOUSE>;
        };

        // 日本語にしてマウスレイヤを抜ける（Mac）
        ime_ja_exit: ime_ja_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT4>, <&tog_off MOUSE>;
        };

        // 英語にしてマウスレイヤを抜ける（Windows JIS: 英数キー）
        ime_en_win: ime_en_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>, <&tog_off MOUSE>;
        };

        // 日本語にしてマウスレイヤを抜ける（Windows JIS: カタカナひらがなキー）
        ime_ja_win: ime_ja_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT2>, <&tog_off MOUSE>;
        };
    };

    behaviors {
        // レイヤを OFF にするだけのトグル（マウスレイヤ終了用）
        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        // Spc用のレイヤータップ：速く打っている最中は必ずスペースになる
        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Enter：タップでEnter、左手のキーを押して離すまで押さえていたらShift
        mt_ent: mt_ent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 21 22 23 24 25 26 33 34 35 36 37 38>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: 基本
        default_layer {
            bindings = <
&kp Q            &kp W     &kp E     &kp R     &kp T                                     &kp Y     &kp U     &kp I      &kp O    &kp P
&kp A            &kp S     &kp D     &kp F     &kp G                         &kp MINUS   &kp H     &kp J     &kp K      &kp L    &kp SEMI
&kp Z            &kp X     &kp C     &kp V     &kp B         &kp SLASH       &kp EQUAL   &kp N     &kp M     &kp COMMA  &kp DOT  &kp SQT
&kp LCTRL        &kp LALT  &kp LSHFT &kp LGUI  &mo NAV       &lt SYM TAB     &lt_spc NUM SPACE &kp BSPC                        &mt_ent RSHFT RET
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 1: マウス（ボールを動かすと自動で入る）— J=左クリック, K=右クリック。J/K・左親指修飾キー以外を押すか、英語/日本語コンボで抜ける
        mouse_layer {
            bindings = <
&trans           &trans    &trans    &trans    &trans                                    &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans                        &trans      &trans    &mkp MB1  &mkp MB2   &trans   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 2: 記号（Tab長押し）
        sym_layer {
            bindings = <
&kp EXCL         &kp AT    &kp DLLR  &trans    &kp TILDE                               &trans    &kp LBKT  &kp RBKT   &trans   &kp PRCNT
&kp LGUI         &kp LALT  &kp LCTRL &kp LSHFT &kp GRAVE                    &trans      &kp HASH  &kp LPAR  &kp RPAR   &kp BSLH &trans
&trans           &kp STAR  &kp CARET &trans    &trans        &trans          &trans      &kp AMPS  &kp LBRC  &kp RBRC   &kp PIPE &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_right_left>;
        };

        // 3: 数字（左手テンキー）＋ Fキー（右手4列）（Spc長押し）
        num_layer {
            bindings = <
&trans           &kp N7    &kp N8    &kp N9    &kp STAR                                  &trans    &kp F7    &kp F8     &kp F9   &kp F12
&trans           &kp N4    &kp N5    &kp N6    &kp PLUS                      &trans      &trans    &kp F4    &kp F5     &kp F6   &kp F11
&trans           &kp N1    &kp N2    &kp N3    &kp SLASH     &trans          &trans      &trans    &kp F1    &kp F2     &kp F3   &kp F10
&trans           &trans    &trans    &trans    &kp N0        &kp DOT         &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 4: 移動（左手真ん中の親指）— この間ボールはスクロール
        //    右手は逆T字：I=↑ / J=← K=↓ L=→、両端の H/; が Home/End、↑ の両脇の U/O が PgUp/PgDn
        nav_layer {
            bindings = <
&trans           &trans    &trans    &trans    &trans                                    &trans    &kp PG_UP &kp UP     &kp PG_DN &trans
&kp LGUI         &kp LALT  &kp LCTRL &kp LSHFT &trans                        &trans      &kp HOME  &kp LEFT  &kp DOWN   &kp RIGHT &kp END
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // 5: 設定（Tab＋Spc 同時長押し）— E で Windows モード ON/OFF
        sys_layer {
            bindings = <
&out OUT_USB     &out OUT_BLE &tog WIN &trans  &trans                                    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&trans           &trans    &trans    &trans    &trans                        &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &bootloader     &bootloader &trans    &trans    &trans     &trans   &bt BT_CLR
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 6: Windows モード（SYS 層の E でトグル）— 親指列の Ctrl と Win(Cmd) を入れ替えるだけ。他は全て下の層のまま
        //    sensor-bindings は書かない（最上位層なので書くとエンコーダを奪ってしまう。省略すれば下の層に任される）
        win_layer {
            bindings = <
&trans           &trans    &trans    &trans    &trans                                    &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans                        &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans    &trans    &trans     &trans   &trans
&kp LGUI         &trans    &trans    &kp LCTRL &trans        &trans          &trans      &trans                                   &trans
            >;
        };
    };
};
