#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// レイヤー番号
#define BASE 0
#define SYM  1
#define NUM  2
#define NAV  3   // 押している間ボールがスクロールになる（mona2_r.overlay の scroller が layer 3 を見ている）
#define SYS  4

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // J + K 同時押しで左クリック（押しっぱなしでドラッグ）
        click_left {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
            layers = <BASE>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // K + L 同時押しで右クリック
        click_right {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
            layers = <BASE>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // 英語 + 日本語 同時押しで設定レイヤー
        combo_sys {
            bindings = <&mo SYS>;
            key-positions = <38 39>;
        };
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: 基本
        default_layer {
            bindings = <
&kp Q            &kp W     &kp E     &kp R     &kp T                                     &kp Y     &kp U     &kp I      &kp O    &kp P
&kp A            &kp S     &kp D     &kp F     &kp G                         &kp ESC     &kp H     &kp J     &kp K      &kp L    &kp SEMI
&mt LSHFT Z      &kp X     &kp C     &kp V     &kp B         &kp TAB         &kp SLASH   &kp N     &kp M     &kp COMMA  &kp DOT  &mt RSHFT SQT
&kp LCTRL        &kp LALT  &kp LGUI  &kp BSPC  &lt SYM SPACE &lt NAV INT5    &lt NUM INT4  &kp RET                                &kp MINUS
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 1: 記号（Spc長押し）
        sym_layer {
            bindings = <
&kp QMARK        &trans    &kp EQUAL &kp LBRC  &kp TILDE                                 &trans    &kp RBRC  &kp EXCL   &trans   &kp PRCNT
&kp AT           &kp DLLR  &kp PLUS  &kp LPAR  &kp GRAVE                     &trans      &kp HASH  &kp RPAR  &trans     &kp PIPE &kp COLON
&trans           &kp STAR  &kp CARET &kp LBKT  &kp BSLH      &trans          &trans      &kp AMPS  &kp RBKT  &kp LT     &kp GT   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_right_left>;
        };

        // 2: 数字（左手テンキー）＋ Fキー（右手4列）（日本語長押し）
        num_layer {
            bindings = <
&kp SLASH        &kp N7    &kp N8    &kp N9    &kp MINUS                                 &trans    &kp F1    &kp F2     &kp F3   &kp F4
&kp STAR         &kp N4    &kp N5    &kp N6    &kp PLUS                      &trans      &trans    &kp F5    &kp F6     &kp F7   &kp F8
&kp EQUAL        &kp N1    &kp N2    &kp N3    &kp DOT       &trans          &trans      &trans    &kp F9    &kp F10    &kp F11  &kp F12
&kp LCTRL        &kp LALT  &kp LGUI  &kp LSHFT &kp N0        &kp RET         &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // 3: 移動（英語長押し）— この間ボールはスクロール
        nav_layer {
            bindings = <
&trans           &trans    &trans    &trans    &trans                                    &kp HOME  &kp PG_DN &kp PG_UP  &kp END  &trans
&kp LGUI         &kp LALT  &kp LCTRL &kp LSHFT &trans                        &trans      &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // 4: 設定（英語＋日本語 同時長押し）
        sys_layer {
            bindings = <
&out OUT_USB     &out OUT_BLE &trans &trans    &trans                                    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&trans           &trans    &trans    &trans    &trans                        &trans      &trans    &trans    &trans     &trans   &trans
&trans           &trans    &trans    &trans    &trans        &bootloader     &bootloader &trans    &trans    &trans     &trans   &bt BT_CLR
&trans           &trans    &trans    &trans    &trans        &trans          &trans      &trans                                   &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};
